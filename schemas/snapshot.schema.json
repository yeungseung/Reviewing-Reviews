{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "snapshot.schema.json",
  "title": "REVIEW2 Source Snapshot",
  "type": "object",
  "required": [
    "snapshot_id",
    "source_id",
    "captured_at",
    "capture_tier",
    "capture_method",
    "status",
    "artifacts"
  ],
  "properties": {
    "snapshot_id": {"type": "string"},
    "source_id": {"type": "string"},
    "captured_at": {"type": "string", "format": "date-time"},
    "final_url": {"type": ["string", "null"]},
    "content_type": {"type": ["string", "null"]},
    "capture_tier": {"enum": ["LIGHT", "STANDARD", "ARCHIVE"]},
    "capture_method": {
      "enum": ["browser", "download", "pdf", "video", "api", "manual", "warc", "wacz"]
    },
    "status": {"enum": ["pending", "captured", "verified", "invalid"]},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "role", "path", "sha256"],
        "properties": {
          "artifact_id": {"type": "string"},
          "role": {
            "enum": [
              "raw",
              "html",
              "pdf",
              "warc",
              "wacz",
              "extracted_text",
              "screenshot",
              "frame",
              "clip",
              "metadata",
              "other"
            ]
          },
          "path": {"type": "string"},
          "sha256": {"type": "string"},
          "bytes": {"type": ["integer", "null"], "minimum": 0},
          "parent_artifact_id": {"type": ["string", "null"]},
          "transformation": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "response_metadata": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "verified_at": {"type": ["string", "null"], "format": "date-time"},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
