{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "component-registry.schema.json",
  "title": "REVIEW2 Component Registry",
  "type": "object",
  "required": ["name", "schema_version", "items"],
  "properties": {
    "$schema": {"type": "string"},
    "name": {"type": "string"},
    "schema_version": {"type": "string"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "manifest"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "kind": {
            "enum": [
              "review2:primitive",
              "review2:pattern",
              "review2:scene",
              "review2:fx",
              "review2:vendor"
            ]
          },
          "manifest": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
