{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "search-plan.schema.json",
  "title": "REVIEW2 Search Plan",
  "type": "object",
  "required": ["search_plan_id", "product_id", "region", "languages", "buyer_questions", "query_families"],
  "properties": {
    "search_plan_id": {"type": "string"},
    "product_id": {"type": "string"},
    "region": {"type": "string"},
    "languages": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "time_window": {
      "type": ["object", "null"],
      "properties": {
        "start": {"type": ["string", "null"]},
        "end": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "buyer_questions": {"type": "array", "items": {"type": "string"}},
    "query_families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["family", "queries"],
        "properties": {
          "family": {"type": "string"},
          "queries": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "target_tiers": {
            "type": "array",
            "items": {"enum": ["official", "expert", "user"]}
          },
          "target_kinds": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "coverage_goals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "tiers"],
        "properties": {
          "question": {"type": "string"},
          "tiers": {
            "type": "array",
            "items": {"enum": ["official", "expert", "user"]}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
